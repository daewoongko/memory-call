# 이 파일을 복사해서 .env 로 만드세요:  cp .env.example .env
#
# Google AI Studio 무료 키 발급 (신용카드 불필요):
#   https://aistudio.google.com/apikey

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=AIza여기에_실제_키
LLM_MODEL=gemini-3.5-flash

# 모델이 404면 python tools/check_key.py 로 목록 확인 후 위 값을 바꾸세요.
# 무료 티어 후보: gemini-3.5-flash / gemini-3.1-flash-lite
#
# 나중에 OpenAI로 갈아탈 때는 이 세 줄만 교체:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o
