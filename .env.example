# Copy this file to .env and fill in local secrets. Never commit .env.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=replace-with-your-key
LLM_MODEL=gemini-3.5-flash
# Interactive calls fail quickly instead of stacking the SDK's hidden retries.
# LLM_REQUEST_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=3
# Live replies stream internally and use a smaller output budget.
# LLM_FAST_MAX_TOKENS=384
# LLM_FAST_REASONING_EFFORT=

# ElevenLabs does voice-cloned TTS and realtime STT. Family-specific voice ids
# are created in the settings screen and stored server-side in SQLite.
ELEVENLABS_API_KEY=replace-with-your-key
# eleven_flash_v2_5 is the lowest-latency multilingual model. Swap to
# eleven_multilingual_v2 for higher quality at the cost of more latency.
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_REQUEST_TIMEOUT_SECONDS=20
# Realtime Scribe uses ELEVENLABS_API_KEY through a 15-minute browser token.
# ELEVENLABS_STT_TOKEN_TIMEOUT_SECONDS=10

# Anam renders the selected family's ElevenLabs voice as a low-latency avatar.
# A custom avatar is created when that family's current photo is confirmed; its
# provider id is stored server-side in SQLite. Only a short-lived session token
# reaches the browser.
ANAM_API_KEY=replace-with-your-anam-key
# ANAM_AVATAR_MODEL=cara-4
# ANAM_REQUEST_TIMEOUT_SECONDS=12

# Lip-sync is optional. Without it, calls still work end-to-end with
# ElevenLabs audio only. Running tools/tts_bridge.py exposes a local MuseTalk
# worker through a Cloudflare Quick Tunnel so the deployed backend can reach
# it; already-synthesized audio is forwarded there for rendering.
TTS_SERVICE_URL=http://127.0.0.1:8002
TTS_BRIDGE_TOKEN=replace-with-a-long-random-token
MEMORY_CALL_RENDER_URL=https://memory-call.onrender.com

# Optional bridge controls (defaults shown).
# TTS_BRIDGE_TTL_SECONDS=120
# TTS_BRIDGE_ALLOWED_HOSTS=trycloudflare.com
# TTS_RATE_LIMIT_PER_MINUTE=6
# TTS_GLOBAL_RATE_LIMIT_PER_MINUTE=12
# TTS_MAX_CONCURRENT=1

# MuseTalk 1.5 runs as the only local worker (see tools/tts_bridge.py).
# MUSETALK_PYTHON_PATH=C:\Users\you\memory-call\.tools\python310\bin\python.exe
# MEMORY_CALL_MUSETALK_DIR=C:\Users\you\Models\MuseTalk
# MUSE_TALK_SOURCE_VIDEO=C:\Users\you\memory-call\data\faces\loops\idle.mp4
# MUSE_TALK_PORT=8002

# Browser speech fallback is disabled by default. Vite reads this setting from
# frontend/.env.local during local development; opt in only when explicitly needed.
VITE_TTS_BROWSER_FALLBACK=false
# Use MuseTalk after the opening age morph. Set false for audio-only playback.
VITE_MUSETALK_LIPSYNC=true
# Anam is attempted first after the age morph; false keeps the MuseTalk path.
VITE_ANAM_LIPSYNC=true

# Production persistent storage location (Render sets this in render.yaml).
# STORAGE_DIR=/app/storage

# Optional local model locations for age generation and validation.
# MEMORY_CALL_MODELS_DIR=C:\Users\you\Models
# FLUX2_COMPONENTS_DIR=C:\Users\you\Models\FLUX2-klein-4B-components
# FLUX2_FP8_CHECKPOINT=C:\Users\you\Models\FLUX2-klein-4b-fp8\flux-2-klein-4b-fp8.safetensors
# REAGING_MODEL_DIR=C:\Users\you\Models\face_reaging
# REAGING_MODEL_PATH=C:\Users\you\Models\face_reaging\best_unet_model.pth

# OpenAI-compatible alternative example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-with-your-key
# LLM_MODEL=gpt-4o
