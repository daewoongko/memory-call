# 이 파일을 복사해서 .env 로 만드세요:  cp .env.example .env
#
# Google AI Studio 무료 키 발급 (신용카드 불필요):
#   https://aistudio.google.com/apikey

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=AIza여기에_실제_키
LLM_MODEL=gemini-3.5-flash

# 배포 시 업로드 파일과 SQLite를 저장할 경로. 로컬에서는 생략해도 된다.
# STORAGE_DIR=/app/storage

# 정식 인증 전 공개 데모를 보호하는 임시 계정.
# 비밀번호를 비우면 보호가 꺼지므로 공개 배포에서는 반드시 설정한다.
DEMO_USERNAME=demo
DEMO_PASSWORD=여기에_긴_데모_비밀번호

# 모델이 404면 python tools/check_key.py 로 목록 확인 후 위 값을 바꾸세요.
# 무료 티어 후보: gemini-3.5-flash / gemini-3.1-flash-lite
#
# 나중에 OpenAI로 갈아탈 때는 이 세 줄만 교체:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o
